# ===========================================================================
# ملف البيئة — قيم توضيحية فقط. انسخه إلى .env ثم عدّل القيم.
#   cp .env.example .env && php artisan key:generate
# لا ترفع ملف .env إلى Git أبدًا. بيانات قاعدة البيانات تُكتب هنا على الخادم فقط.
# ===========================================================================

APP_NAME="متجري"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
# يُنصح بضبطها مرة واحدة قبل أول طلب وعدم تغييرها لاحقًا (مثال: Asia/Riyadh, Asia/Amman, Africa/Cairo)
APP_TIMEZONE=UTC

# --- قاعدة البيانات (قيم توضيحية — ضع بيانات الاستضافة الحقيقية هنا فقط) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=

# --- الجلسات والكاش (ملفات: لا تحتاج جداول إضافية على الاستضافة المشتركة) ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- السجلات ---
LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- رمز التثبيت الأول (مهم جدًا) ---
# قيمة عشوائية طويلة تُدخلها في صفحة /install. مطلوبة في بيئة production.
# أنشئ واحدة بالأمر: php -r "echo bin2hex(random_bytes(16)),PHP_EOL;"
# بعد اكتمال التثبيت تُغلق الصفحة تلقائيًا، ويمكنك حذف هذا السطر.
INSTALL_TOKEN=

# --- البريد (مثال SMTP — استبدل القيم بقيم مزوّد البريد الفعلي) ---
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
